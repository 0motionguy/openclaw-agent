{
  "name": "openclaw-agent",
  "version": "1.0.0",
  "description": "Interactive installer for OpenClaw agent automation tools — browser, desktop, and Android control via DOM/accessibility trees",
  "main": "bin/cli.js",
  "bin": {
    "openclaw-setup": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "agent/",
    "config/",
    "prompts/",
    "workflows/",
    "docs/",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/0motionguy/openclaw-agent.git"
  },
  "homepage": "https://github.com/0motionguy/openclaw-agent#readme",
  "bugs": {
    "url": "https://github.com/0motionguy/openclaw-agent/issues"
  },
  "scripts": {
    "setup": "node bin/cli.js",
    "verify": "node bin/cli.js --verify",
    "configure": "node bin/cli.js --configure",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ bin/ agent/"
  },
  "keywords": [
    "ai-agent",
    "browser-automation",
    "mcp",
    "ollama",
    "playwright",
    "accessibility",
    "dom-automation",
    "openclaw"
  ],
  "author": "0motionguy",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "inquirer": "^9.2.12",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "vitest": "^3.0.0",
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module"
}
